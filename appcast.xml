<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<rss version="2.0"
     xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle"
     xmlns:dc="http://purl.org/dc/elements/1.1/">
    <channel>
        <title>Clippy</title>
        <link>https://raw.githubusercontent.com/Harman206/clippy-updates/main/appcast.xml</link>
        <description>Clippy — always-on macOS assistant. Update feed (legacy Sparkle clients only — current app polls GitHub Releases directly).</description>
        <language>en</language>

        <!--
            Starting with Clippy 0.2.3 the app no longer uses Sparkle —
            UpdateChecker.swift polls the GitHub Releases API directly.
            This appcast is kept around so any pre-0.2.3 installs in the
            wild still see "0.2.3 available" and get pointed at the
            GitHub release page where they can grab the new DMG.

            sparkle:releaseNotesLink gives Sparkle a "View More Info…"
            button; the lack of <enclosure> means Sparkle's in-place
            installer is skipped (which is fine — the new app has its
            own checker).
        -->

        <item>
            <title>Version 0.2.3</title>
            <pubDate>Mon, 18 May 2026 13:48:00 +0000</pubDate>
            <sparkle:version>0.2.3</sparkle:version>
            <sparkle:shortVersionString>0.2.3</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <sparkle:releaseNotesLink>https://github.com/Harman206/clippy-updates/releases/tag/v0.2.3</sparkle:releaseNotesLink>
            <description><![CDATA[
                <ul>
                    <li>Replaced Sparkle with a GitHub Releases poller — no more Keychain prompts on release day.</li>
                    <li>Click "View More Info…" then download the DMG from the GitHub release page. After installing 0.2.3, future updates check automatically and pop a one-click Download alert.</li>
                </ul>
            ]]></description>
        </item>

    </channel>
</rss>
